# Copy to .env and fill in for local development.

# --- Embeddings ---
# Provider used both for ingestion and for embedding incoming questions.
# The SAME provider/model must be used everywhere, or vector search breaks.
# Supported: "ollama" | "openai" | "groq"
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
# Must match the output dimensionality of EMBEDDING_MODEL.
# nomic-embed-text (Ollama) = 768, text-embedding-3-small (OpenAI) = 1536.
EMBEDDING_DIMENSIONS=768
EMBEDDING_API_KEY=

# --- Generation ---
# Supported: "ollama" | "groq"
GENERATION_PROVIDER=ollama
GENERATION_MODEL=qwen3:0.6b
GENERATION_API_KEY=

# --- Ollama ---
OLLAMA_URL=http://localhost:11434

# --- Groq (used when EMBEDDING_PROVIDER/GENERATION_PROVIDER=groq) ---
GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/openai/v1

# --- OpenAI (used when EMBEDDING_PROVIDER=openai) ---
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1

# --- Redis (Sidekiq) ---
REDIS_URL=redis://localhost:6379/0

# --- Rate limiting ---
ASK_RATE_LIMIT_PER_MINUTE=10

# --- Admin panel (/admin) ---
# Required to access /admin at all -- see app/controllers/admin/base_controller.rb.
# No default is provided on purpose; leaving these unset locks the admin
# panel out entirely (503) rather than falling back to a guessable value.
ADMIN_USERNAME=
ADMIN_PASSWORD=
