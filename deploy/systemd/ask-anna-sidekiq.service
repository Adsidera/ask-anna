# Template systemd unit for Sidekiq (DocumentIngestionJob), per spec
# "Deploy (VPS Hetzner)": "Sidekiq come servizio systemd separato".
#
# Install:
#   sudo cp deploy/systemd/ask-anna-sidekiq.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now ask-anna-sidekiq

[Unit]
Description=Ask Anna - Sidekiq (background jobs)
After=network.target redis.service postgresql.service

[Service]
Type=simple
User=ask-anna
WorkingDirectory=/var/www/ask-anna/current
Environment=RAILS_ENV=production
EnvironmentFile=/var/www/ask-anna/shared/.env
ExecStart=/var/www/ask-anna/current/bin/bundle exec sidekiq -e production
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
