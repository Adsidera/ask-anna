<main class="min-h-screen bg-gray-50 px-4 py-10">
  <div class="mx-auto w-full max-w-4xl">
    <%= render "admin/nav" %>

    <div class="mb-6 flex items-center justify-between">
      <h1 class="text-2xl font-bold text-gray-900">Suggested questions</h1>
      <%= link_to "New suggested question", new_admin_suggested_question_path,
            class: "rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-700" %>
    </div>

    <div class="overflow-x-auto rounded-xl border border-gray-200 bg-white shadow-sm">
      <table class="w-full text-left text-sm">
        <thead class="border-b border-gray-200 bg-gray-50 text-xs uppercase tracking-wide text-gray-500">
          <tr>
            <th class="px-4 py-3 font-medium">Question</th>
            <th class="px-4 py-3 font-medium">Status</th>
            <th class="px-4 py-3"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @suggested_questions.each do |suggested_question| %>
            <tr>
              <td class="px-4 py-3">
                <%= link_to suggested_question.question, admin_suggested_question_path(suggested_question), class: "font-medium text-gray-900 hover:underline" %>
              </td>
              <td class="px-4 py-3">
                <% if !suggested_question.active? %>
                  <span class="inline-block rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-500">inactive</span>
                <% elsif suggested_question.embedding.present? %>
                  <span class="inline-block rounded-full bg-green-50 px-2 py-0.5 text-xs text-green-700">ready</span>
                <% else %>
                  <span class="inline-block rounded-full bg-amber-50 px-2 py-0.5 text-xs text-amber-600">pending embedding</span>
                <% end %>
              </td>
              <td class="px-4 py-3 text-right">
                <%= link_to "Edit", edit_admin_suggested_question_path(suggested_question), class: "text-gray-600 hover:underline" %>
                <%= button_to "Delete", admin_suggested_question_path(suggested_question), method: :delete,
                      form: { class: "inline", onsubmit: "return confirm('Delete this suggested question?')" },
                      class: "ml-3 inline cursor-pointer bg-transparent p-0 text-red-600 hover:underline" %>
              </td>
            </tr>
          <% end %>

          <% if @suggested_questions.empty? %>
            <tr>
              <td colspan="3" class="px-4 py-8 text-center text-gray-500">
                No suggested questions yet.
                <%= link_to "Add the first one", new_admin_suggested_question_path, class: "text-gray-900 hover:underline" %>.
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</main>
