<%= form_with model: [ :admin, suggested_question ], class: "flex flex-col gap-4" do |f| %>
  <% if suggested_question.errors.any? %>
    <div class="rounded-lg bg-red-50 px-4 py-3 text-sm text-red-700">
      <p class="font-medium">
        <%= pluralize(suggested_question.errors.count, "error") %> prevented this suggested question from being saved:
      </p>
      <ul class="mt-1 list-inside list-disc">
        <% suggested_question.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :question, class: "block text-sm font-medium text-slate-900" %>
    <%= f.text_field :question, required: true,
          class: "mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
    <p class="mt-1 text-xs text-slate-500">
      The canonical phrasing. Paraphrases of this question are matched by embedding similarity
      (see SUGGESTED_QUESTION_MATCH_DISTANCE_THRESHOLD) and get the answer below instead of a
      generated one.
    </p>
  </div>

  <div>
    <%= f.label :answer, class: "block text-sm font-medium text-slate-900" %>
    <%= f.text_area :answer, rows: 8, required: true,
          class: "mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
  </div>

  <div>
    <%= f.label :source_url, "Source URL (optional)", class: "block text-sm font-medium text-slate-900" %>
    <%= f.url_field :source_url, placeholder: "https://...",
          class: "mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
    <p class="mt-1 text-xs text-slate-500">Shown as a source link next to this answer.</p>
  </div>

  <div class="flex items-center gap-2">
    <%= f.check_box :active, class: "h-4 w-4 rounded border-slate-300" %>
    <%= f.label :active, "Active (shown as a suggestion and matched against questions)", class: "text-sm text-slate-900" %>
  </div>

  <div class="flex items-center gap-3">
    <%= f.submit class: "cursor-pointer rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700" %>
    <%= link_to "Cancel", suggested_question.persisted? ? admin_suggested_question_path(suggested_question) : admin_suggested_questions_path,
          class: "text-sm text-slate-600 hover:underline" %>
  </div>
<% end %>
