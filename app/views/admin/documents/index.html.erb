<main class="min-h-screen bg-gray-50 px-4 py-10">
  <div class="mx-auto w-full max-w-4xl">
    <%= render "admin/nav" %>

    <div class="mb-6 flex items-center justify-between">
      <h1 class="text-2xl font-bold text-gray-900">Documents</h1>
      <%= link_to "New document", new_admin_document_path,
            class: "rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-700" %>
    </div>

    <div class="overflow-x-auto rounded-xl border border-gray-200 bg-white shadow-sm">
      <table class="w-full text-left text-sm">
        <thead class="border-b border-gray-200 bg-gray-50 text-xs uppercase tracking-wide text-gray-500">
          <tr>
            <th class="px-4 py-3 font-medium">Title</th>
            <th class="px-4 py-3 font-medium">Type</th>
            <th class="px-4 py-3 font-medium">Chunks</th>
            <th class="px-4 py-3 font-medium">Published</th>
            <th class="px-4 py-3"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @documents.each do |document| %>
            <tr>
              <td class="px-4 py-3">
                <%= link_to document.title, admin_document_path(document), class: "font-medium text-gray-900 hover:underline" %>
              </td>
              <td class="px-4 py-3">
                <span class="inline-block rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-700">
                  <%= document.source_type.humanize %>
                </span>
              </td>
              <td class="px-4 py-3 text-gray-600">
                <% if document.chunks.size.zero? %>
                  <span class="text-amber-600">pending</span>
                <% else %>
                  <%= pluralize(document.chunks.size, "chunk") %>
                <% end %>
              </td>
              <td class="px-4 py-3 text-gray-600"><%= document.published_at&.to_fs(:long) || "—" %></td>
              <td class="px-4 py-3 text-right">
                <%= link_to "Edit", edit_admin_document_path(document), class: "text-gray-600 hover:underline" %>
                <%= button_to "Delete", admin_document_path(document), method: :delete,
                      form: { class: "inline", onsubmit: "return confirm('Delete this document and its chunks? This cannot be undone.')" },
                      class: "ml-3 inline cursor-pointer bg-transparent p-0 text-red-600 hover:underline" %>
              </td>
            </tr>
          <% end %>

          <% if @documents.empty? %>
            <tr>
              <td colspan="5" class="px-4 py-8 text-center text-gray-500">
                No documents yet. <%= link_to "Add the first one", new_admin_document_path, class: "text-gray-900 hover:underline" %>.
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</main>
