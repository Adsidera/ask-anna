<%= form_with model: [ :admin, document ], multipart: true, class: "flex flex-col gap-4" do |f| %>
  <% if document.errors.any? %>
    <div class="rounded-lg bg-red-50 px-4 py-3 text-sm text-red-700">
      <p class="font-medium">
        <%= pluralize(document.errors.count, "error") %> prevented this document from being saved:
      </p>
      <ul class="mt-1 list-inside list-disc">
        <% document.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :title, class: "block text-sm font-medium text-gray-900" %>
    <%= f.text_field :title, required: true,
          class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-gray-800" %>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :source_type, class: "block text-sm font-medium text-gray-900" %>
      <%= f.select :source_type, Document::SOURCE_TYPES, { include_blank: "Select a type" },
            required: true,
            class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-gray-800" %>
    </div>

    <div>
      <%= f.label :published_at, class: "block text-sm font-medium text-gray-900" %>
      <%= f.date_field :published_at,
            class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-gray-800" %>
    </div>
  </div>

  <div>
    <%= f.label :source_url, "Source URL (optional)", class: "block text-sm font-medium text-gray-900" %>
    <%= f.url_field :source_url, placeholder: "https://...",
          class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-gray-800" %>
    <p class="mt-1 text-xs text-gray-500">
      Shown as a source next to answers<% unless document.persisted? %>. Leaving "Content" below blank while
      filling this in fetches and strips the page's HTML for you instead of pasting text<% end %>.
    </p>
  </div>

  <% unless document.persisted? %>
    <div>
      <%= f.label :pdf_file, "Or upload a PDF", class: "block text-sm font-medium text-gray-900" %>
      <%= f.file_field :pdf_file, accept: "application/pdf",
            class: "mt-1 block w-full text-sm text-gray-900 file:mr-3 file:rounded-lg file:border-0 file:bg-gray-900 file:px-3 file:py-2 file:text-sm file:font-medium file:text-white hover:file:bg-gray-700" %>
      <p class="mt-1 text-xs text-gray-500">
        Extracts text from the PDF and uses it as the content, taking priority over both fields above.
      </p>
    </div>
  <% end %>

  <div>
    <%= f.label :raw_content, "Content", class: "block text-sm font-medium text-gray-900" %>
    <%= f.text_area :raw_content, rows: 12,
          class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 font-mono text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-gray-800" %>
    <p class="mt-1 text-xs text-gray-500">
      Updating this re-chunks and re-embeds the document from scratch.
    </p>
  </div>

  <div class="flex items-center gap-3">
    <%= f.submit class: "cursor-pointer rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-700" %>
    <%= link_to "Cancel", document.persisted? ? admin_document_path(document) : admin_documents_path,
          class: "text-sm text-gray-600 hover:underline" %>
  </div>
<% end %>
