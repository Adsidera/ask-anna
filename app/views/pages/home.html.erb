<main class="bg-linear-to-tr from-indigo-600 via-gray-50 to-indigo-50 min-h-screen bg-gray-50 flex flex-col items-center px-4 py-10">
  <div class="w-full max-w-2xl">
    <header class="mb-6 text-center">
      <h1 class="text-3xl font-bold text-indigo-950">Ask Anna</h1>
      <p class="mt-2 text-slate-600">
        Ask a question about Anna Costalonga's professional experience.
      </p>
    </header>

    <div
      id="ask-anna-log"
      class="flex h-105 flex-col gap-3 overflow-y-auto rounded-xl border border-gray-200 bg-white p-4 shadow-sm"
    >
      <p class="max-w-[85%] self-start rounded-lg bg-gray-100 px-3 py-2 text-sm text-gray-700">
        Ask me anything about Anna's professional experience.
      </p>
    </div>

    <% if @suggested_questions.any? %>
      <div id="ask-anna-suggestions" class="mt-3 flex flex-wrap gap-2">
        <% @suggested_questions.each do |suggested_question| %>
          <button
            type="button"
            data-suggested-question="<%= suggested_question.question %>"
            class="rounded-full border border-amber-400 bg-amber-200 px-3 py-1.5 text-xs font-medium text-amber-950 shadow-sm hover:bg-amber-300"
          >
            <%= suggested_question.question %>
          </button>
        <% end %>
      </div>
    <% end %>

    <form id="ask-anna-form" class="mt-4 flex gap-2">
      <textarea
        id="ask-anna-input"
        rows="1"
        placeholder="Ask a question..."
        class="flex-1 resize-none rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500"
      ></textarea>
      <button
        id="ask-anna-submit"
        type="submit"
        class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700 disabled:opacity-50"
      >
        Send
      </button>
    </form>
  </div>
</main>

<script src="/home.js" defer></script>
