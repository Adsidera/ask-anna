<main class="min-h-screen bg-gray-50 flex flex-col items-center px-4 py-10">
  <div class="w-full max-w-2xl">
    <header class="mb-6 text-center">
      <h1 class="text-3xl font-bold text-gray-900">Ask Anna</h1>
      <p class="mt-2 text-gray-600">
        Ask a question about Anna Costalonga's professional experience.
      </p>
    </header>

    <div
      id="ask-anna-log"
      class="flex h-[420px] flex-col gap-3 overflow-y-auto rounded-xl border border-gray-200 bg-white p-4 shadow-sm"
    >
      <p class="max-w-[85%] self-start rounded-lg bg-gray-100 px-3 py-2 text-sm text-gray-700">
        Ask me anything about Anna's professional experience.
      </p>
    </div>

    <form id="ask-anna-form" class="mt-4 flex gap-2">
      <textarea
        id="ask-anna-input"
        rows="1"
        placeholder="Ask a question..."
        class="flex-1 resize-none rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-gray-800"
      ></textarea>
      <button
        id="ask-anna-submit"
        type="submit"
        class="rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-700 disabled:opacity-50"
      >
        Send
      </button>
    </form>
  </div>
</main>

<script src="/home.js" defer></script>
